generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  USER
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
  AGOTADO
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

// ─── Modelos ──────────────────────────────────────────────────────────────────

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  email     String   @unique
  password  String
  telefono  String?
  rol       Rol      @default(USER)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carrito   Carrito?
  pedidos   Pedido[]

  @@map("usuarios")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  slug        String     @unique
  descripcion String?
  icono       String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  productos   Producto[]

  @@map("categorias")
}

model Producto {
  id           Int            @id @default(autoincrement())
  nombre       String         @db.VarChar(150)
  descripcion  String?        @db.Text
  precio       Decimal        @db.Decimal(10, 2)
  precioOferta Decimal?       @db.Decimal(10, 2)
  stock        Int            @default(0)
  imagen       String?
  imagenes     Json?          @default("[]")
  marca        String?
  modelo       String?
  material     String?
  color        String?
  categoriaId  Int
  estado       EstadoProducto @default(ACTIVO)
  destacado    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  categoria    Categoria      @relation(fields: [categoriaId], references: [id])
  carritoItems CarritoItem[]
  pedidoItems  PedidoItem[]

  @@map("productos")
}

model Carrito {
  id        Int           @id @default(autoincrement())
  usuarioId Int           @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  usuario   Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items     CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id         Int      @id @default(autoincrement())
  carritoId  Int
  productoId Int
  cantidad   Int      @default(1)
  createdAt  DateTime @default(now())

  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([carritoId, productoId])
  @@map("carrito_items")
}

model Pedido {
  id          Int          @id @default(autoincrement())
  usuarioId   Int
  total       Decimal      @db.Decimal(10, 2)
  estado      EstadoPedido @default(PENDIENTE)
  direccion   String?
  ciudad      String?
  telefono    String?
  notas       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  items       PedidoItem[]

  @@map("pedidos")
}

model PedidoItem {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  productoId Int
  cantidad   Int
  precioUnit Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)

  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("pedido_items")
}
